# for testing the application with Docker

export LOG_STANDARD_LOGGER__root=WARNING

export DB_HOST=db-test
export DB_PORT=5432
export DB_USER=test
export DB_PASS=test!,test
export DB_NAME=test

# Work around SIGILL in cryptography's bundled OpenSSL on Apple M4 Docker VMs (SME detection)
export OPENSSL_armcap=0
